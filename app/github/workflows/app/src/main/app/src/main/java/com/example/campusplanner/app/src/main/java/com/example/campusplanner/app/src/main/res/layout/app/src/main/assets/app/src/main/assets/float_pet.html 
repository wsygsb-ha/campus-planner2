<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:transparent;overflow:hidden;width:160px;height:160px}
#pet{width:140px;height:140px;margin:10px auto;cursor:pointer;}
</style>
</head>
<body>
<div id="pet">
<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
  <!--像素小人 -->
  <rect x="35" y="10" width="30" height="30" fill="#ffbc80"/>
  <rect x="42" y="20" width="6" height="6" fill="#222"/>
  <rect x="52" y="20" width="6" height="6" fill="#222"/>
  <rect x="44" y="32" width="12" height="4" fill="#dd5555"/>
  <rect x="30" y="40" width="40" height="35" fill="#4285F4"/>
  <rect x="25" y="42" width="8" height="25" fill="#ffbc80"/>
  <rect x="67" y="42" width="8" height="25" fill="#ffbc80"/>
  <rect x="33" y="75" width="12" height="18" fill="#222"/>
  <rect x="55" y="75" width="12" height="18" fill="#222"/>
</svg>
</div>
<script>
const pet = document.getElementById("pet");
const words = ["上课啦！","记得打卡","去健身！","别熬夜","今天也要加油","作业写完了吗"];
pet.onclick = ()=>{
  alert(words[Math.floor(Math.random()*words.length)]);
}
</script>
</body>
</html>
